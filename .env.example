NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/junvideo
JWT_SECRET=replace-this-with-a-long-random-secret
LOCAL_TIME_ZONE=Asia/Shanghai
DAILY_PARSE_LIMIT=10
PARSER_MODE=auto
YTDLP_PATH=bin/yt-dlp.exe
# Optional, for public links that require your authorized browser session.
# Set only one of these; never commit cookie files or browser profiles.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
# If yt-dlp is blocked by Douyin's direct API check, JunVideo can use a fresh
# isolated Chrome/Edge page to read the same public page response. It never
# imports your browser profile or cookies. Set false to disable this fallback.
DOUYIN_BROWSER_FALLBACK=true
# Optional absolute browser path; otherwise Chrome/Edge is auto-detected.
JUNVIDEO_BROWSER_PATH=
BROWSER_FALLBACK_TIMEOUT_MS=35000
# Optional external XHS-Downloader API. The official project exposes POST /xhs/detail.
# Keep this empty unless you have started that sidecar yourself.
XHS_DOWNLOADER_API_URL=
XHS_DOWNLOADER_TIMEOUT_MS=20000
# Optional values forwarded to XHS-Downloader for links requiring an authorized session.
# Do not commit cookies or credentials.
XHS_DOWNLOADER_COOKIE=
XHS_DOWNLOADER_PROXY=
FFMPEG_PATH=
PARSE_TIMEOUT_MS=45000
CORS_ORIGIN=http://localhost:5173
DEV_VIP_ENABLED=true
VITE_DEFAULT_LOCALE=zh
