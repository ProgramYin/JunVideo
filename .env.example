NODE_ENV=development
PORT=4000
# Production containers can serve the built Vite client from the same origin.
SERVE_CLIENT=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/junvideo
JWT_SECRET=replace-this-with-a-long-random-secret
LOCAL_TIME_ZONE=Asia/Shanghai
DAILY_PARSE_LIMIT=10
PARSER_MODE=yt-dlp
YTDLP_PATH=bin/yt-dlp.exe
# yt-dlp uses HTTP(S) extractors. Keep retries explicit so one parse request
# does not silently wait through five or ten upstream attempts.
YTDLP_RETRIES=0
YTDLP_EXTRACTOR_RETRIES=0
YTDLP_FRAGMENT_RETRIES=0
YTDLP_SOCKET_TIMEOUT_MS=15000
# Keep a logged-out YouTube-compatible client in the default set. Override
# this only when you intentionally provide another yt-dlp extractor policy.
YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,android
# Optional JavaScript runtime for yt-dlp's current YouTube challenge handling.
# Production Docker images provide Node.js; leave empty when unavailable.
YTDLP_JS_RUNTIMES=
# Media and subtitle dependencies. yt-dlp discovers/downloads subtitle tracks;
# ffmpeg/ffprobe handle separate streams and embedded text subtitle tracks.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEXT_EXTRACTION_ENABLED=true
TEXT_EXTRACTION_TIMEOUT_MS=30000
TEXT_EXTRACTION_MAX_BYTES=8388608
TEXT_EXTRACTION_MAX_CUES=20000
TEXT_EXTRACTION_MAX_CHARS=2000000
# Optional, for public links that require your authorized browser session.
# Set only one of these; never commit cookie files or browser profiles.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
# If yt-dlp is blocked by Douyin's direct API check, JunVideo can use a fresh
# isolated Chrome/Edge page to read the same public page response. It never
# imports your browser profile or cookies. Set false to disable this fallback.
DOUYIN_BROWSER_FALLBACK=true
# Optional absolute browser path; otherwise Chrome/Edge is auto-detected.
JUNVIDEO_BROWSER_PATH=
BROWSER_FALLBACK_TIMEOUT_MS=35000
# Optional external XHS-Downloader API. The official project exposes POST /xhs/detail.
# Keep this empty unless you have started that sidecar yourself.
XHS_DOWNLOADER_API_URL=
XHS_DOWNLOADER_TIMEOUT_MS=20000
# Optional values forwarded to XHS-Downloader for links requiring an authorized session.
# Do not commit cookies or credentials.
XHS_DOWNLOADER_COOKIE=
XHS_DOWNLOADER_PROXY=
PARSE_TIMEOUT_MS=45000
# Downloads that require yt-dlp + ffmpeg merging may be much longer than
# metadata parsing. This is an upper bound for one authenticated request.
MEDIA_DOWNLOAD_TIMEOUT_MS=3600000
CORS_ORIGIN=http://localhost:5173
DEV_VIP_ENABLED=true
VITE_DEFAULT_LOCALE=zh
# Full API base including /api. Leave empty for same-origin deployments.
VITE_API_BASE_URL=
