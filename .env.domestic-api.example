NODE_ENV=production
PORT=8080
SERVE_CLIENT=false
PARSER_MODE=yt-dlp

# Supabase Transaction Pooler connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
DATABASE_SSL=true
DATABASE_POOL_MAX=10
JWT_SECRET=<at-least-32-random-characters>

# The Cloudflare Pages origin allowed to call this API.
CORS_ORIGIN=https://jun-video.pages.dev

# Vercel/browser-cookie sources are not used on the domestic API.
# Configure both encrypted values after exporting an authorized Netscape cookie file.
YTDLP_COOKIES_ENCRYPTED=
YTDLP_COOKIES_ENCRYPTION_KEY=

# Keep the API container independent from a local Chrome installation.
DOUYIN_BROWSER_FALLBACK=false
DAILY_PARSE_LIMIT=10
PARSE_TIMEOUT_MS=90000
MEDIA_DOWNLOAD_TIMEOUT_MS=3600000
LOCAL_TIME_ZONE=Asia/Shanghai
